NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USE_SYNTHETIC_DATA=false

# Communication delivery remains disabled until the provider review, signed
# agreement, verified senders, staging callbacks, and database LIVE gate are complete.
COMMUNICATIONS_DELIVERY_ENABLED=false
COMMUNICATIONS_PUBLIC_BASE_URL=https://scheduler.example.org
COMMUNICATIONS_BATCH_SIZE=20
CRON_SECRET=

# SMS through Twilio. Prefer a Messaging Service for Advanced Opt-Out.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+15551234567

# Email through Twilio SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_REGION=GLOBAL
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
