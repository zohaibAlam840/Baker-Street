NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://scheduler.example.org
SUPABASE_SERVICE_ROLE_KEY=
USE_SYNTHETIC_DATA=false
RELEASE_SHA=

# Optional enterprise SAML SSO routed through Supabase Auth. Configure exactly
# one provider ID or verified email domain after the client's IdP is connected.
ENTERPRISE_SSO_ENABLED=false
ENTERPRISE_SSO_LABEL=Work SSO
ENTERPRISE_SSO_PROVIDER_ID=
ENTERPRISE_SSO_DOMAIN=

# Optional read-only FHIR R4 capability connection. Local FHIR bundle exports
# work without this connection. Outbound resource writes are intentionally off
# until the client approves a vendor, scopes, identifiers, and data mappings.
EHR_INTEGRATION_ENABLED=false
EHR_FHIR_BASE_URL=
EHR_FHIR_AUTH_MODE=NONE
EHR_FHIR_BEARER_TOKEN=
EHR_FHIR_TOKEN_URL=
EHR_FHIR_CLIENT_ID=
EHR_FHIR_CLIENT_SECRET=
EHR_FHIR_SCOPE=
EHR_FHIR_TIMEOUT_MS=8000

# Read-only guardian portal. Enable only after the email-link template, redirect
# allowlist, rate limits, guardian verification policy, and support owner are ready.
GUARDIAN_PORTAL_ENABLED=false

# FHIR Claim draft coding and optional clearinghouse adapter. Live submission
# remains off until payer mappings, diagnosis source, identifiers, BAA, sandbox,
# and idempotency behavior are approved.
CLAIMS_SERVICE_CODE_MAP_JSON={}
CLAIMS_SUBMISSION_ENABLED=false
CLAIMS_FHIR_SUBMISSION_URL=
CLAIMS_FHIR_BEARER_TOKEN=
CLAIMS_SUBMISSION_TIMEOUT_MS=10000

# Optional OpenAI-compatible interpretation endpoint. The deterministic parser
# always runs first. Do not approve PHI until the vendor/hosting, BAA, retention,
# logging, region, and incident controls have passed client review.
LLM_ASSISTANT_ENABLED=false
LLM_ASSISTANT_PHI_APPROVED=false
LLM_ASSISTANT_BASE_URL=
LLM_ASSISTANT_API_KEY=
LLM_ASSISTANT_MODEL=
LLM_ASSISTANT_TIMEOUT_MS=6000

# Mobile store association. Keep both disabled until the client supplies the
# final package/bundle identities and production signing information. SHA-256
# fingerprints are colon-delimited; separate multiple Android signers by comma.
MOBILE_ANDROID_APP_LINKS_ENABLED=false
MOBILE_ANDROID_PACKAGE_ID=
MOBILE_ANDROID_SHA256_CERT_FINGERPRINTS=
MOBILE_IOS_UNIVERSAL_LINKS_ENABLED=false
MOBILE_IOS_TEAM_ID=
MOBILE_IOS_BUNDLE_ID=

# Set these only in the secure operator shell used for a backup/restore drill.
# Never put a recovery service-role key or HMAC key in browser-visible variables.
RECOVERY_SUPABASE_URL=
RECOVERY_SUPABASE_SERVICE_ROLE_KEY=
RECOVERY_MANIFEST_HMAC_KEY=

# Communication delivery remains disabled until the provider review, signed
# agreement, verified senders, staging callbacks, and database LIVE gate are complete.
COMMUNICATIONS_DELIVERY_ENABLED=false
COMMUNICATIONS_PUBLIC_BASE_URL=https://scheduler.example.org
COMMUNICATIONS_BATCH_SIZE=20
# Shared by the protected communications worker and operational alert endpoint.
# Use at least 16 random characters.
CRON_SECRET=

# Aggregate operational alert thresholds. These signals contain counts only,
# never patient, provider, contact, or request data.
ALERT_EXPIRY_DAYS=45
ALERT_COMMUNICATION_FAILURE_THRESHOLD=5
ALERT_COMMUNICATION_BACKLOG_THRESHOLD=20
ALERT_FAILED_SIGN_IN_THRESHOLD=10
ALERT_OPTIMIZER_BOUNDED_THRESHOLD=10
ALERT_PUSH_FAILURE_THRESHOLD=5

# SMS through Twilio. Prefer a Messaging Service for Advanced Opt-Out.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+15551234567

# Email through Twilio SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_REGION=GLOBAL
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@example.org
# The protected push worker claims this many alerts and sends at most this many
# provider requests concurrently on each five-minute invocation.
PUSH_DELIVERY_BATCH_SIZE=50
PUSH_DELIVERY_CONCURRENCY=5
SCHEDULING_TIMEZONE=America/New_York

# Optional private CP-SAT service. When omitted, scheduling uses the local
# deterministic bounded optimizer. Use an HTTPS origin and a random server-only
# secret of at least 24 characters. Local development may use 127.0.0.1 HTTP.
CP_SAT_SOLVER_URL=
CP_SAT_SOLVER_SECRET=
CP_SAT_REQUIRED=false
CP_SAT_TIMEOUT_MS=9000
CP_SAT_MAX_CANDIDATES=4000
CP_SAT_TIME_LIMIT_SECONDS=8
