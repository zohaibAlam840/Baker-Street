{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/public.e2e.ts",
    "test:e2e:roles": "playwright test e2e/role-access.e2e.ts --project=desktop-chromium",
    "test:e2e:report": "playwright show-report",
    "test:solver": "python -m unittest discover -s services/cp_sat_solver/tests -v",
    "seed:users": "tsx scripts/seed-auth-users.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "verify:environment": "tsx scripts/verify-environment.ts",
    "verify:mobile-release": "tsx scripts/verify-mobile-release.ts",
    "recovery:manifest": "tsx scripts/recovery-manifest.ts",
    "verify:role-access": "tsx --env-file=.env --env-file=.env.local scripts/verify-recovery-access.ts",
    "verify:recovery-access": "tsx --env-file=.env --env-file=.env.local scripts/verify-recovery-access.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sendgrid/client": "^8.1.6",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "twilio": "^6.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
